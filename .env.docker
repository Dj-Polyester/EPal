# Database
POSTGRES_USER=epal
POSTGRES_PASSWORD=epal
POSTGRES_DB=epal
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# vLLM
# HF model ID (auto-downloads — recommended for Docker):
VLLM_MODEL=Qwen3-4B-GGUF

# For local GGUF files (manual mode only; Docker requires extra setup):
# VLLM_GGUF_PATH=vllm/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# VLLM_BASE_MODEL=Qwen/Qwen3-4B

VLLM_PORT=8001
VLLM_TENSOR_PARALLEL=1
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.25

# ComfyUI
COMFYUI_PORT=8188
COMFYUI_PATH=$HOME/comfy/ComfyUI
COMFYUI_INPUT_PATH=/app/ComfyUI/input

# Backend
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-256-bit-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
