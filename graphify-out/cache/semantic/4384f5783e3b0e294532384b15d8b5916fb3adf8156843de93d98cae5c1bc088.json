{"nodes": [{"id": "scalability_design", "label": "Scalability Design", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend is stateless (JWT auth, no server sessions). WebSocket uses Redis pub/sub architecture-ready. vLLM scales vertically with tensor/pipeline parallelism and horizontally behind a load balancer. ComfyUI scales via multiple instances behind a queue worker. PostgreSQL can use read replicas."}, {"id": "cross_platform_design", "label": "Cross-Platform Design", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docker Compose provides containerized cross-platform local development. PowerShell scripts (.ps1) for Windows and shell scripts (.sh) for Linux/macOS provide manual setup parity."}, {"id": "jwt_auth_pattern", "label": "JWT Authentication Pattern", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT-based authentication with separate access and refresh tokens enables stateless backend suitable for horizontal scaling behind a load balancer."}, {"id": "memory_architecture", "label": "Memory Architecture", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sliding context window plus automatic summarization in the Chat.summary field provides long-term memory for characters."}, {"id": "media_generation_concept", "label": "Media Generation Concept", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Characters detect requests for image/video/audio in natural language and generate media via ComfyUI. The app gracefully handles missing models."}], "edges": [{"source": "scalability_design", "target": "fastapi_app", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "scalability_design", "target": "docker_compose_backend", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "cross_platform_design", "target": "docker_compose_postgres", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "cross_platform_design", "target": "start_backend_script", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "jwt_auth_pattern", "target": "get_current_user", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "jwt_auth_pattern", "target": "create_access_token", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "jwt_auth_pattern", "target": "create_refresh_token", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "memory_architecture", "target": "chat_model", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "media_generation_concept", "target": "media_model", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_