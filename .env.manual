# Backend (manual run — services on localhost)
DATABASE_URL=postgresql+asyncpg://epal:epal@localhost:5432/epal
REDIS_URL=redis://localhost:6379/0
VLLM_BASE_URL=http://localhost:8001/v1
COMFYUI_URL=http://localhost:8188
SECRET_KEY=your-super-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# vLLM (if running outside Docker too)
VLLM_MODEL=unsloth/Qwen3-0.6B-GGUF:Q4_K_M
VLLM_BASE_MODEL=Qwen/Qwen3-0.6B
VLLM_PORT=8001
VLLM_TENSOR_PARALLEL=1
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.5